# Redirigir todo el tráfico al directorio /public
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 0. DOMINIO Y PROTOCOLO CANONICOS
    # Canonicaliza en una sola capa, contemplando requests HTTPS terminadas en CDN/proxy.
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)$ [NC]
    RewriteCond %{HTTP_HOST} !^mifolkloreargentino\.com$ [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://mifolkloreargentino.com%{REQUEST_URI} [L,R=301,NE]

    # 1. MODO MANTENIMIENTO (Intercepción temprana)
    # Definimos la página a mostrar para el mantenimiento
    ErrorDocument 503 /public/maintenance.html

    RewriteCond %{DOCUMENT_ROOT}/.down -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/.down -f
    RewriteCond %{REQUEST_URI} !^/public/maintenance\.html$ [NC]
    RewriteCond %{REQUEST_URI} !^/public/.* [NC]
    RewriteRule ^ - [L,R=503]

    # 2. SEGURIDAD: Ocultar /public de la URL
    # Redirige dominio.com/public/algo a dominio.com/algo
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,R=301]

    # 3. REDIRECCIONES DE LEGADO (SEO)
    RewriteRule ^biografias-de-artistas-folkloricos/(.*)$ /$1/biografia [R=301,L]
    RewriteRule ^discografias-del-folklore-argentino/(.*)$ /$1/discografia [R=301,L]
    RewriteRule ^letras-de-canciones-folkloricas/interprete-(.*)$ /$1/letras [R=301,L]
    RewriteRule ^letras-de-canciones-folkloricas/([^/]+)/([^/]+)$ /$1/letras/$2 [R=301,L]
    RewriteRule ^biografia-de-(.*)$ /$1/biografia [R=301,L]
    RewriteRule ^noticias-de-([^/]+)/([^/]+)$ /$1/noticias/$2 [R=301,L]
    RewriteRule ^noticias-de-(.*)$ /$1/noticias [R=301,L]
    RewriteRule ^discografia-de-([^/]+)/([^/]+)$ /$1/discografia/$2 [R=301,L]
    RewriteRule ^discografia-de-(.*)$ /$1/discografia [R=301,L]
    RewriteRule ^letras-de-canciones-de-([^/]+)/([^/]+)$ /$1/letras/$2 [R=301,L]
    RewriteRule ^letras-de-canciones-de-(.*)$ /$1/letras [R=301,L]

    # 4. REDIRECCIÓN PRINCIPAL A /PUBLIC
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"

    # Cache-Control explicito ademas de Expires: assets versionados por Vite
    # (hash en el nombre de archivo, dentro de /build/) pueden cachearse
    # como inmutables por un anio; el resto de estaticos, con un TTL mas corto.
    <FilesMatch "^.+\.(css|js|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "^.+\.(jpe?g|png|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <IfModule mod_setenvif.c>
        SetEnvIf Request_URI "^/build/" is_versioned_asset
    </IfModule>
    Header set Cache-Control "public, max-age=31536000, immutable" env=is_versioned_asset
</IfModule>

<IfModule mod_deflate.c>
    # Compresion Brotli/Gzip para HTML, CSS, JS y JSON. Las imagenes ya
    # viajan comprimidas (JPEG/WebP) y no se benefician de recomprimirlas.
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf application/font-woff application/font-woff2 font/woff2
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>

# Deshabilitar la listade directorios
Options -Indexes
