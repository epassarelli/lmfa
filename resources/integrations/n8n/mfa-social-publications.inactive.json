{
  "name": "MFA - Publicación Facebook con ledger (preparación)",
  "active": false,
  "settings": {"executionOrder": "v1", "saveDataSuccessExecution": "none", "saveDataErrorExecution": "none", "saveManualExecutions": false},
  "nodes": [
    {"id":"manual","name":"Inicio manual","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,0],"parameters":{}},
    {"id":"gate","name":"Validar configuración","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,0],"parameters":{"jsCode":"if (!$vars.MFA_API_BASE_URL || !$vars.MFA_RENDER_WORKFLOW_ID) throw new Error('Configurar API HTTPS y subflujo de render aprobado antes de continuar'); if (!$vars.MFA_API_BASE_URL.startsWith('https://')) throw new Error('La API debe usar HTTPS'); return [{json:{}}];"}},
    {"id":"candidates","name":"Candidatos","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[440,0],"parameters":{"url":"={{ $vars.MFA_API_BASE_URL + '/social-publications/candidates?provider=facebook&per_page=1' }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","options":{"timeout":30000}}},
    {"id":"choose","name":"Preparar reserva","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,0],"parameters":{"jsCode":"const candidate=$json.data?.[0]; if (!candidate) return []; const key='xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return (c==='x'?r:(r&3)|8).toString(16)}); return [{json:{...candidate,request_key:key}}];"}},
    {"id":"claim","name":"Reservar","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[880,0],"parameters":{"method":"POST","url":"={{ $vars.MFA_API_BASE_URL + '/social-publications/claims' }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Idempotency-Key","value":"={{ $json.request_key }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ { content_kind:$json.content_kind,content_id:$json.content_id,provider:'facebook',destination_key:$json.destination_key,n8n_execution_id:$execution.id } }}","options":{"timeout":30000}}},
    {"id":"render","name":"Render aprobado y alojamiento","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[1100,0],"parameters":{"source":"database","workflowId":{"__rl":true,"value":"={{ $vars.MFA_RENDER_WORKFLOW_ID }}","mode":"id"},"options":{"waitForSubWorkflow":true}}},
    {"id":"prepare","name":"Validar placa","type":"n8n-nodes-base.code","typeVersion":2,"position":[1320,0],"parameters":{"jsCode":"const c=$('Reservar').item.json; if(c.replayed || !c.lease) throw new Error('Reserva repetida: no enviar; consultar estado'); if(!$json.asset_reference || !/^[a-f0-9]{64}$/.test($json.asset_sha256||'')) throw new Error('Falta placa pública real y SHA256'); return [{json:{...c,asset_reference:$json.asset_reference,asset_sha256:$json.asset_sha256}}];"}},
    {"id":"begin","name":"Autorizar un envío","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1540,0],"parameters":{"method":"POST","url":"={{ $vars.MFA_API_BASE_URL + '/social-publications/' + $json.target_id + '/begin' }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ {attempt_id:$json.attempt_id,lease:$json.lease,content_hash:$json.payload.content_hash,asset_reference:$json.asset_reference,asset_sha256:$json.asset_sha256} }}","options":{"timeout":30000}}},
    {"id":"meta","name":"Meta - UN solo POST","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1760,0],"retryOnFail":false,"onError":"continueRegularOutput","parameters":{"method":"POST","url":"https://graph.facebook.com/v27.0/145931542128207/photos","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"contentType":"form-urlencoded","bodyParameters":{"parameters":[{"name":"url","value":"={{ $('Validar placa').item.json.asset_reference }}"},{"name":"caption","value":"={{ $('Reservar').item.json.payload.copy }}"}]},"options":{"timeout":30000,"response":{"response":{"fullResponse":true,"neverError":true}}}}},
    {"id":"classify","name":"Clasificar resultado","type":"n8n-nodes-base.code","typeVersion":2,"position":[1980,0],"parameters":{"jsCode":"const c=$('Reservar').item.json; const status=Number($json.statusCode||0); const post=$json.body?.post_id; const base={target_id:c.target_id,attempt_id:c.attempt_id,lease:c.lease}; if(status>=200 && status<300 && /^145931542128207_[0-9]+$/.test(post||'')) return [{json:{...base,outcome:'success',external_post_id:post}}]; if(status>=400 && status<500 && status!==408 && $json.body?.error) return [{json:{...base,outcome:'definitive_failure',error_code:'META_REJECTED',provider_http_status:status,failure_evidence:'provider_rejected'}}]; return [{json:{...base,outcome:'uncertain',error_code:'META_OUTCOME_UNKNOWN'}}];"}},
    {"id":"result","name":"Confirmar resultado - solo callback","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2200,0],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000,"parameters":{"method":"POST","url":"={{ $vars.MFA_API_BASE_URL + '/social-publications/' + $json.target_id + '/result' }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ $json }}","options":{"timeout":30000}}}
  ],
