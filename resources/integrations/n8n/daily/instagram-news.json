      "parameters": {
        "jsCode": "const c=$json.data?.[0]; if(!c)return []; const test=$('Configuración y bloqueo').first().json.test_news_id; if(test && c.content_id!==test) throw new Error('Prueba limitada a noticia833'); const request_key='xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.floor(Math.random()*16);return(c==='x'?r:(r&3)|8).toString(16)});return [{json:{...c,request_key}}];"
